# JIRA Cloud configuration
# Your JIRA site, e.g. https://your-domain.atlassian.net
JIRA_BASE_URL=https://your-domain.atlassian.net
# The email of the JIRA account that owns the API token
JIRA_EMAIL=you@example.com
# Create one at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-jira-api-token

# LLM configuration (optional).
# If no LLM key is set, the agent falls back to a deterministic field mapping.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI (only if LLM_PROVIDER=azure)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-06-01
